# 萤石开放平台
EZVIZ_APP_KEY=your_app_key_here
EZVIZ_APP_SECRET=your_app_secret_here
EZVIZ_ACCESS_TOKEN=

# 数据库（支持PostgreSQL和SQLite）
# PostgreSQL: postgresql://postgres:password@localhost:5432/elderly_monitor
# SQLite: sqlite:///./elderly_monitor.db
DATABASE_URL=sqlite:///./elderly_monitor.db

# 服务配置
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=True

# 告警配置
ALERT_HIGH_THRESHOLD=0.8
ALERT_MEDIUM_THRESHOLD=0.6
ALERT_LOW_THRESHOLD=0.3

# WebSocket
WS_HEARTBEAT_INTERVAL=30

# SDNL1雷达（根据实际情况配置）
SDNL1_API_URL=
SDNL1_API_KEY=
